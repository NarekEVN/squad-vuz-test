# -----------------------------------------------------------------------------
# Squad of Champions API: environment configuration
#
#   cp backend/.env.example backend/.env
#
# The defaults below work out of the box with `docker compose up --build`.
# They use the compose service names (postgres, redis, mongo) as hosts.
# To run the API on your host machine instead, swap those hosts for `localhost`.
#
# Every value here is for local development only. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Origin allowed by CORS (the React app)
FRONTEND_URL=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- PostgreSQL (primary database) ------------------------------------------
# Must match the postgres service credentials in docker-compose.yml
DATABASE_URL=postgres://squad:squad@postgres:5432/squad_of_champions

# --- Redis (cache + WebSocket adapter) --------------------------------------
REDIS_URL=redis://redis:6379
# TTL in seconds for cached character lists, items and filter values
CACHE_TTL_SECONDS=3600

# --- MongoDB (bonus: activity log) ------------------------------------------
# Must match the mongo service credentials in docker-compose.yml
MONGO_URL=mongodb://squad:squad@mongo:27017/squad_of_champions?authSource=admin

# --- Auth --------------------------------------------------------------------
# Dev-only placeholder. Generate a real one with: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-secret-at-least-32-characters
# Access token lifetime in seconds
JWT_EXPIRES_IN_SECONDS=3600

# --- Seed --------------------------------------------------------------------
# Path to the ORIGINAL characters JSON from the frontend repo (mounted read-only
# in Docker). The file is never modified.
CHARACTERS_JSON_PATH=../frontend/src/data/characters.json
